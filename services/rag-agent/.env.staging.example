# STAGING — rag-agent. Ver docs/arquitetura/staging.md.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=1600
ANTHROPIC_THINKING_MODE=disabled

EMBEDDING_PROVIDER=voyageai
EMBEDDING_API_KEY=xxxxxxxxxxxxxxxx
EMBEDDING_MODEL=voyage-3-large
EMBEDDING_DIMENSIONS=1024

# Postgres de STAGING com pgvector (mesma instância do api-gateway de staging).
DATABASE_URL=postgresql://usuario:senha@HOST_STAGING:5432/nutrideby_staging

APP_ENV=staging
LOG_LEVEL=INFO
KNOWLEDGE_BASE_TOP_K=5
