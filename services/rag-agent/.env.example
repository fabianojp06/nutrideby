# --- Anthropic (obrigatório — único provedor de geração, conforme DPA assinado) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-opus-5

# --- Embeddings (provedor configurável — não usado para geração de texto) ---
# Opções suportadas: voyageai | openai
EMBEDDING_PROVIDER=voyageai
EMBEDDING_API_KEY=xxxxxxxxxxxxxxxx
EMBEDDING_MODEL=voyage-3-large
EMBEDDING_DIMENSIONS=1024

# --- Banco de dados (PostgreSQL com extensão pgvector habilitada) ---
DATABASE_URL=postgresql://usuario:senha@localhost:5432/nutrideby_rag

# --- Aplicação ---
APP_ENV=development
LOG_LEVEL=INFO
KNOWLEDGE_BASE_TOP_K=5
