# Token do bot obtido via @BotFather no Telegram
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Conexão com o mesmo Postgres usado pelo services/api-gateway
# Este serviço cria/mantém apenas sua própria tabela (telegram_vinculo), não migra o schema do api-gateway
DATABASE_URL=postgresql://nutrideby:nutrideby@localhost:5432/nutrideby?schema=public

# Chave compartilhada simples para autenticar chamadas internas (api-gateway/scheduler -> este serviço)
# Enviada no header: X-Internal-Api-Key
INTERNAL_API_KEY=troque-por-uma-chave-forte-em-producao

# Porta HTTP exposta por este serviço para receber gatilhos de notificação
PORT=3333

# URL base do api-gateway, caso este serviço precise consultar dados do paciente/nutricionista
API_GATEWAY_BASE_URL=http://localhost:3000

# TTL (em horas) do token de vinculação de conta gerado pelo admin-web/api-gateway
LINK_TOKEN_TTL_HOURS=48
