// Schema Prisma — services/api-gateway
// Fonte de verdade do modelo relacional do NutriDeby (Fase 0).
// Dados de saúde (Prontuario, PlanoAlimentar) exigem criptografia em repouso
// no nível de infraestrutura (disco/volume) e TLS 1.2+ em trânsito — ver
// NutriDeby_Compliance_Juridico_LGPD_Analise.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlanoAssinatura {
  STARTER
  PRO
  CLINICA
}

enum StatusAssinatura {
  TRIAL
  ATIVA
  INADIMPLENTE
  CANCELADA
  EXPIRADA
}

enum StatusConsentimento {
  PENDENTE
  ACEITO
  REVOGADO
}

enum SexoBiologico {
  MASCULINO
  FEMININO
}

// Origem do plano alimentar: criado manualmente pela nutri, ou derivado de um
// rascunho do Agente Clínico RAG. IA_RASCUNHO dispara o disclaimer CFN
// "sugestão para revisão do profissional" na UI.
enum OrigemPlano {
  MANUAL
  IA_RASCUNHO
}

// Item 20 — anamnese de pré-consulta auto-declarada pelo paciente.
// PENDENTE_REVISAO: enviada pelo paciente, aguardando a nutri. INCORPORADA:
// a nutri revisou e assinou (transpôs para o Prontuario oficial). Gate de
// revisão profissional, em espírito igual ao aprovadoPeloNutri do plano.
enum StatusAnamnese {
  PENDENTE_REVISAO
  INCORPORADA
}

// Controladora (paga assinatura) — LGPD: controladora dos dados do paciente
model Nutricionista {
  id           String   @id @default(uuid())
  nome         String
  email        String   @unique
  senhaHash    String
  crn          String   @unique
  telefone     String?
  // CPF/CNPJ — obrigatório para criar cliente na Asaas (integração de
  // assinatura). Opcional no cadastro para não travar o onboarding;
  // AssinaturasService valida a presença antes de chamar a Asaas.
  cpfCnpj      String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  ativo        Boolean  @default(true)

  pacientes   Paciente[]
  assinatura  Assinatura?
  auditLogs   AuditLog[]

  @@map("nutricionistas")
}

// Titular dos dados (uso gratuito via PWA)
model Paciente {
  id             String   @id @default(uuid())
  nome           String
  email          String   @unique
  senhaHash      String
  telefone       String?
  dataNascimento DateTime?
  sexoBiologico  SexoBiologico?
  criadoEm       DateTime @default(now())
  atualizadoEm   DateTime @updatedAt
  ativo          Boolean  @default(true)

  nutricionistaId String
  nutricionista   Nutricionista @relation(fields: [nutricionistaId], references: [id])

  // Termo de Consentimento (LGPD) — obrigatório antes de qualquer
  // tratamento de dado de saúde. Ver ConsentGuard em src/common/guards.
  statusConsentimento    StatusConsentimento @default(PENDENTE)
  consentimentoVersao    String?
  consentimentoAssinadoEm DateTime?
  consentimentoRevogadoEm DateTime?

  prontuarios      Prontuario[]
  planosAlimentares PlanoAlimentar[]
  registrosPeso    RegistroPeso[]
  registrosDiario  RegistroDiario[]
  anamnesesAutodeclaradas AnamneseAutodeclarada[]

  @@map("pacientes")
}

// Item 20 — anamnese auto-declarada pelo paciente ANTES da consulta.
// Entidade SEPARADA do Prontuario: é dado auto-declarado (não oficial). A
// nutri revisa e incorpora (transpõe manualmente para o Prontuario via
// POST /pacientes/:id/prontuarios); este registro nunca escreve no prontuário.
// Antropometria aqui é provisória/auto-declarada — não confundir com a do
// Prontuario, medida pela nutri na consulta.
model AnamneseAutodeclarada {
  id         String   @id @default(uuid())
  pacienteId String
  paciente   Paciente @relation(fields: [pacienteId], references: [id])

  status                StatusAnamnese @default(PENDENTE_REVISAO)
  respondidoEm          DateTime       @default(now())
  incorporadoEm         DateTime?
  incorporadoPorNutriId String?

  // Anamnese auto-declarada
  objetivo             String?
  queixaPrincipal      String?
  historicoClinico     String?
  historicoFamiliar    String?
  habitosAlimentares   String?
  usoMedicamentos      String?
  alergias             String?
  intolerancias        String?
  nivelAtividadeFisica String?
  preferenciasAversoes String?
  rotinaRefeicoes      String?
  consumoAgua          String?
  habitoIntestinal     String?
  sono                 String?
  consumoAlcool        String?
  tabagismo            String?
  gestacaoLactacao     String?
  praticaExercicio     String?
  suplementos          String?
  observacoesGerais    String?

  // Antropometria auto-declarada (provisória)
  pesoDeclaradoKg   Decimal? @db.Decimal(5, 2)
  alturaDeclaradaCm Decimal? @db.Decimal(5, 2)

  @@map("anamneses_autodeclaradas")
}

// US-14: paciente registra o próprio peso periodicamente (distinto do
// pesoKg do Prontuario, que é medido pelo nutricionista na consulta).
// Alimenta o mesmo gráfico de evolução de US-07 no Admin Web.
model RegistroPeso {
  id           String   @id @default(uuid())
  pacienteId   String
  paciente     Paciente @relation(fields: [pacienteId], references: [id])
  pesoKg       Decimal  @db.Decimal(5, 2)
  registradoEm DateTime @default(now())

  @@map("registros_peso")
}

// US-13: diário alimentar simples — texto e/ou foto, sem análise por IA
// nesta fase. `fotoUrl` assume que o upload em si é feito em outro lugar
// (ex.: storage direto do front) e só a URL final chega aqui — não há
// upload de arquivo implementado neste serviço.
model RegistroDiario {
  id           String   @id @default(uuid())
  pacienteId   String
  paciente     Paciente @relation(fields: [pacienteId], references: [id])
  texto        String?
  fotoUrl      String?
  registradoEm DateTime @default(now())

  @@map("registros_diario")
}

// Anamnese e dados antropométricos — dado de saúde sensível
model Prontuario {
  id         String   @id @default(uuid())
  pacienteId String
  paciente   Paciente @relation(fields: [pacienteId], references: [id])

  // Anamnese
  queixaPrincipal      String?
  historicoClinico     String?
  historicoFamiliar    String?
  habitosAlimentares   String?
  usoMedicamentos      String?
  alergias             String?
  intolerancias        String?
  nivelAtividadeFisica String?
  observacoesGerais    String?

  // Dados antropométricos
  pesoKg           Decimal? @db.Decimal(5, 2)
  alturaCm         Decimal? @db.Decimal(5, 2)
  circunferenciaCintura Decimal? @db.Decimal(5, 2)
  circunferenciaQuadril Decimal? @db.Decimal(5, 2)
  percentualGordura     Decimal? @db.Decimal(5, 2)
  imc                   Decimal? @db.Decimal(5, 2)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("prontuarios")
}

model PlanoAlimentar {
  id         String   @id @default(uuid())
  pacienteId String
  paciente   Paciente @relation(fields: [pacienteId], references: [id])

  titulo            String
  objetivo          String?
  caloriasAlvo      Int?
  refeicoes         Json // estrutura livre: [{ nome, horario, itens: [...] }]
  observacoes       String?
  origem            OrigemPlano @default(MANUAL) // MANUAL x IA_RASCUNHO — dispara o disclaimer CFN na UI
  aprovadoPeloNutri Boolean  @default(false) // gate de compliance para output de IA
  ativo             Boolean  @default(true)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("planos_alimentares")
}

// Assinatura da Nutricionista (Controladora) — integração Asaas futura
model Assinatura {
  id     String @id @default(uuid())

  nutricionistaId String        @unique
  nutricionista   Nutricionista @relation(fields: [nutricionistaId], references: [id])

  plano       PlanoAssinatura
  status      StatusAssinatura @default(TRIAL)
  trialAte    DateTime?

  // Marcado pelo webhook da Asaas quando status vira INADIMPLENTE; limpo
  // quando volta a ATIVA. Base para o período de tolerância antes de
  // suspender acesso (US-17) — ver AssinaturaAtivaGuard.
  inadimplenteDesde DateTime?

  asaasCustomerId      String?
  asaasSubscriptionId  String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("assinaturas")
}

// Tabela Brasileira de Composição de Alimentos (TACO, 4ª edição,
// NEPA-UNICAMP, domínio público) — valores por 100g. Fonte oficial do
// cálculo nutricional (US-11). Seed em prisma/seed-data/taco.json,
// carregado por prisma/seed-taco.ts. `codigo` é o número oficial da TACO,
// estável entre edições da mesma tabela — usado como chave natural.
model AlimentoTaco {
  codigo         Int     @id
  categoria      String
  descricao      String
  umidadePercent Decimal? @db.Decimal(6, 2)
  kcal           Decimal? @db.Decimal(7, 2)
  kj             Decimal? @db.Decimal(7, 2)
  proteinaG      Decimal? @db.Decimal(6, 2)
  lipideosG      Decimal? @db.Decimal(6, 2)
  colesterolMg   Decimal? @db.Decimal(7, 2)
  carboidratoG   Decimal? @db.Decimal(6, 2)
  fibraG         Decimal? @db.Decimal(6, 2)
  cinzasG        Decimal? @db.Decimal(6, 2)
  calcioMg       Decimal? @db.Decimal(7, 2)
  magnesioMg     Decimal? @db.Decimal(7, 2)
  manganesMg     Decimal? @db.Decimal(7, 3)
  fosforoMg      Decimal? @db.Decimal(7, 2)
  ferroMg        Decimal? @db.Decimal(6, 3)
  sodioMg        Decimal? @db.Decimal(7, 2)
  potassioMg     Decimal? @db.Decimal(7, 2)
  cobreMg        Decimal? @db.Decimal(6, 3)
  zincoMg        Decimal? @db.Decimal(6, 3)
  retinolMcg     Decimal? @db.Decimal(7, 2)
  reMcg          Decimal? @db.Decimal(7, 2)
  raeMcg         Decimal? @db.Decimal(7, 2)
  tiaminaMg      Decimal? @db.Decimal(6, 3)
  riboflavinaMg  Decimal? @db.Decimal(6, 3)
  piridoxinaMg   Decimal? @db.Decimal(6, 3)
  niacinaMg      Decimal? @db.Decimal(6, 3)
  vitaminaCMg    Decimal? @db.Decimal(6, 2)

  @@index([descricao])
  @@map("alimentos_taco")
}

// Base de conhecimento do Agente Clínico RAG (services/rag-agent).
// A tabela é criada e populada FORA do Prisma (rag-agent/db/schema.sql +
// scripts/seed_taco_knowledge.py: pgvector + TACO com 597 alimentos). Ela é
// declarada aqui APENAS para que o `prisma db push` do api-gateway a reconheça
// e NÃO a remova como tabela órfã — foi o que causou o incidente de 07/09
// (TACO apagada e re-semeada). O api-gateway não lê nem escreve nesta tabela;
// a coluna `embedding` é Unsupported("vector"), portanto o índice ivfflat sobre
// ela não é gerenciado pelo Prisma (é preservado; o seed o recria com
// CREATE INDEX IF NOT EXISTS). A extensão `vector` também é preservada porque o
// preview `postgresqlExtensions` não está habilitado. NÃO adicionar campos aqui.
model KnowledgeBase {
  id        BigInt                      @id @default(autoincrement())
  source    String
  content   String
  embedding Unsupported("vector(1024)")
  createdAt DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("knowledge_base")
}

// Log de auditoria — obrigatório em toda operação sobre dado sensível
model AuditLog {
  id     String @id @default(uuid())

  nutricionistaId String?
  nutricionista   Nutricionista? @relation(fields: [nutricionistaId], references: [id])

  ator       String // id do usuário (nutricionista ou paciente) que executou a ação
  acao       String // ex: "PRONTUARIO_CRIADO", "CONSENTIMENTO_ACEITO"
  entidade   String // ex: "Prontuario"
  entidadeId String?
  detalhes   Json?
  criadoEm   DateTime @default(now())

  @@map("audit_logs")
}
