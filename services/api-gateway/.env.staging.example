# STAGING — api-gateway. Copie para .env em staging. Segredos PRÓPRIOS de
# staging (nunca reusar os de produção). Ver docs/arquitetura/staging.md.

PORT=3000
NODE_ENV=staging

# Postgres de STAGING (instância separada da de produção).
DATABASE_URL="postgresql://usuario:senha@HOST_STAGING:5432/nutrideby_staging?schema=public"

# JWT — segredos próprios de staging.
JWT_SECRET="staging-troque-por-segredo-forte"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="staging-troque-por-outro-segredo-forte"
JWT_REFRESH_EXPIRES_IN="7d"

# Cripto de campo (item 12) — chave PRÓPRIA de staging (32 bytes base64).
# Gere: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=""

# Asaas — usar SANDBOX em staging.
ASAAS_API_KEY=""
ASAAS_BASE_URL="https://sandbox.asaas.com/api/v3"
ASAAS_WEBHOOK_TOKEN=""

# CORS — URLs dos frontends de staging (Vercel).
CORS_ORIGIN="https://nutrideby-staging.vercel.app,https://nutrideby-admin-web-staging.vercel.app"

TELEGRAM_BOT_USERNAME="NutriBebyBot"

# rag-agent de STAGING (rede interna do Railway staging).
RAG_AGENT_BASE_URL="http://rag-agent.railway.internal:8000"
