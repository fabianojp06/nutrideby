# Copie para .env e preencha com valores reais. NUNCA commitar .env com segredos reais.

# App
PORT=3000
NODE_ENV=development

# Banco de dados (PostgreSQL + pgvector, ver infra/docker-compose.yml)
DATABASE_URL="postgresql://nutrideby:nutrideby@localhost:5432/nutrideby?schema=public"

# JWT
JWT_SECRET="troque-por-um-segredo-forte-em-producao"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="troque-por-outro-segredo-forte-em-producao"
JWT_REFRESH_EXPIRES_IN="7d"

# Asaas (assinaturas recorrentes — ver src/assinaturas/asaas.service.ts).
# Sem ASAAS_API_KEY, o fluxo de assinatura funciona só localmente em TRIAL
# (sem chamar a Asaas) — comportamento seguro para dev/CI sem credenciais.
ASAAS_API_KEY=""
ASAAS_BASE_URL="https://sandbox.asaas.com/api/v3"
# Token arbitrário forte, configurado também no painel da Asaas (Webhooks
# > Token de autenticação) — chega no header `asaas-access-token`.
ASAAS_WEBHOOK_TOKEN=""

# CORS
CORS_ORIGIN="http://localhost:5173,http://localhost:3001"

# Telegram — usado só para montar o deep link de convite (t.me/<username>?start=<token>).
# O vínculo em si é gravado pelo services/telegram-bot na mesma DATABASE_URL.
TELEGRAM_BOT_USERNAME="NutriBebyBot"

# Agente Clínico RAG (services/rag-agent) — gate por plano Pro/Clínica.
RAG_AGENT_BASE_URL="http://localhost:8000"
