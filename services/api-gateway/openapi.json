  "info": {
    "title": "NutriDeby API Gateway",
    "description": "Contrato do api-gateway. Fonte única de tipos para admin-web e pwa-patient — não editar à mão nos clientes.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterNutricionistaDto": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "senha": {
            "type": "string",
            "minLength": 8
          },
          "crn": {
            "type": "string",
            "pattern": "CRN_REGEX"
          },
          "telefone": {
            "type": "string"
          },
          "plano": {
            "type": "string",
            "enum": [
              "STARTER",
              "PRO",
              "CLINICA"
            ]
          }
        },
        "required": [
          "nome",
          "email",
          "senha",
          "crn"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "senha": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "NUTRICIONISTA",
              "PACIENTE"
            ]
          }
        },
        "required": [
          "email",
          "senha",
          "role"
        ]
      },
      "NutricionistaMeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "nome": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "crn": {
            "type": "string"
          },
          "telefone": {
            "type": "string",
            "nullable": true
          },
          "cpfCnpj": {
            "type": "string",
            "nullable": true
          },
          "ativo": {
            "type": "boolean"
          },
          "criadoEm": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "nome",
          "email",
          "crn",
          "telefone",
          "cpfCnpj",
          "ativo",
          "criadoEm"
        ]
      },
      "UpdateNutricionistaDto": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          },
          "telefone": {
            "type": "string"
          },
          "cpfCnpj": {
            "type": "string",
            "pattern": "CPF_CNPJ_REGEX"
          }
        }
      },
      "CreatePacienteDto": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "senha": {
            "type": "string",
            "minLength": 8
          },
